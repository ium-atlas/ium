{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IUM Event",
  "type": "object",
  "required": ["id", "name", "type", "date", "location", "perspectives"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "type": { "enum": ["battle", "siege", "massacre", "council", "political", "treaty", "movement", "culture"] },
    "date": { "type": "string", "pattern": "^-?[0-9]{1,4}-[0-9]{2}$", "description": "YYYY-MM, 기원전은 -YYYY-MM" },
    "location": {
      "type": "object", "required": ["lng", "lat"],
      "properties": { "lng": { "type": "number", "minimum": -180, "maximum": 180 },
                      "lat": { "type": "number", "minimum": -90, "maximum": 90 } }
    },
    "perspectives": {
      "type": "object", "minProperties": 1,
      "additionalProperties": {
        "type": "object", "required": ["weight"],
        "properties": {
          "name": { "type": ["string", "null"] },
          "weight": { "type": "integer", "minimum": 0, "maximum": 100 },
          "weight_modern": { "type": "integer", "minimum": 0, "maximum": 100 },
          "narrative": { "type": ["string", "null"] },
          "sources": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "disputed": {
      "type": "object",
      "required": ["fields", "issue"],
      "properties": {
        "fields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "issue": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    }
  }
}
