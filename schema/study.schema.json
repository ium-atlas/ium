{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ium-atlas.org/schema/study.schema.json",
  "title": "IUM Korean history study module",
  "type": "object",
  "required": ["id", "title", "period", "order", "summary", "topicIds", "sections", "questions"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "period": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2},
    "order": {"type": "integer", "minimum": 1, "maximum": 7},
    "summary": {"type": "string", "minLength": 1},
    "topicIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "sections": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "body", "keyPoints", "eventRefs", "sources"], "properties": {
      "id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "body": {"type": "string", "minLength": 1},
      "keyPoints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
      "eventRefs": {"type": "array", "items": {"type": "object", "required": ["topicId", "eventId"], "properties": {"topicId": {"type": "string", "minLength": 1}, "eventId": {"type": "string", "minLength": 1}}}},
      "sources": {"$ref": "#/$defs/sources"}
    }}},
    "questions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "prompt", "choices", "answerIndex", "explanation", "sectionId", "sources"], "properties": {
      "id": {"type": "string", "minLength": 1}, "prompt": {"type": "string", "minLength": 1},
      "choices": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "answerIndex": {"type": "integer", "minimum": 0, "maximum": 4}, "explanation": {"type": "string", "minLength": 1}, "sectionId": {"type": "string", "minLength": 1}, "sources": {"$ref": "#/$defs/sources"}
    }}}
  },
  "$defs": {"sources": {"type": "array", "minItems": 1, "items": {"type": "string", "format": "uri", "pattern": "^https?://"}}}
}
